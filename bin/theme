#!/usr/bin/env python3
"""theme -- generate and switch the terminal colour theme.

The 16 ANSI colours Ghostty sets are the single source of truth for everything
drawn inside the terminal; this CLI is the only writer of them. See
theme/README.md. All state is the symlinks under theme/gen.
"""

import fcntl
import os
import shutil
import subprocess
import sys
import time
from pathlib import Path

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "theme"))

from gen import build_palette, contrast_report, load_setup_toml  # noqa: E402
from wallpaper import render_wallpaper  # noqa: E402

SETUPS_DIR = REPO / "theme" / "setups"
GEN_GHOSTTY_DIR = REPO / "theme" / "gen" / "ghostty"
GEN_SKETCHYBAR_DIR = REPO / "theme" / "gen" / "sketchybar"
GEN_WALLPAPER_DIR = REPO / "theme" / "gen" / "wallpaper"
SKETCHYBAR_DIR = REPO / "sketchybar"
RELOAD_LOCK = REPO / "theme" / "gen" / "reload.lock"
RELOAD_PENDING = REPO / "theme" / "gen" / "reload.pending"
# How long one reload waits before deciding the appearance flip has settled.
# macOS posts its notification burst ahead of the flag being readable, so a
# reload that does not outlast the burst can only ever see the old mode.
APPEARANCE_SETTLE = 0.4


def theme_names() -> list[str]:
    return sorted(p.stem for p in SETUPS_DIR.glob("*.toml"))


def current_theme_name() -> str | None:
    link = GEN_GHOSTTY_DIR / "current-dark"
    if not link.is_symlink():
        return None
    return os.readlink(link).removesuffix("-dark")


def _next_in(names: list[str], current: str | None) -> str:
    if not names:
        raise SystemExit("theme: nothing to cycle through")
    if current not in names:
        return names[0]
    return names[(names.index(current) + 1) % len(names)]


def _sketchybar_color(hex_color: str) -> str:
    return "0xff" + hex_color.lstrip("#")


def write_ghostty_theme(name: str, setup: dict, built: dict, path: Path) -> None:
    """Write one Ghostty theme file (background/foreground/palette/cursor).

    Colours only. Ghostty silently drops any non-colour key from a file loaded
    as a `theme` -- `background-opacity` and `background-blur` set here have no
    effect at all, with no warning. They go through write_glass instead.
    """
    lines = [
        f"# generated by bin/theme from theme/setups/{name}.toml — do not edit",
        f"background = {built['bg']}",
        f"foreground = {built['fg']}",
    ]
    lines += [f"palette = {i}={c}" for i, c in enumerate(built["palette"])]
    lines += [
        f"cursor-color = {built['cursor']}",
        f"cursor-text = {built['cursor_text']}",
        f"selection-background = {built['selection_bg']}",
        f"split-divider-color = {built['palette'][8]}",
        "",
    ]
    path.write_text("\n".join(lines))


def glass_of(setup: dict, mode: str) -> tuple[float, float]:
    """(opacity, blur) for one mode: `[dark] opacity` wins over the top-level one,
    which is the default both modes fall back to. Same merge rule as `wallpaper`."""
    table = setup.get(mode, {})
    opacity = table.get("opacity", setup.get("opacity", 1))
    blur = table.get("blur", setup.get("blur", 0))
    # Blur is an integer radius: Ghostty rejects "40.0" and falls back to 0.
    return (float(opacity), int(blur))


def write_glass(name: str, setup: dict, mode: str) -> tuple[float, float]:
    """Write themes/glass for `mode`: the window transparency. Returns what it wrote.

    A Ghostty `theme` file may only carry colours -- every other key in it is
    dropped without a warning -- so opacity and blur cannot live where the rest
    of the theme lives. They are a plain `config-file` include instead
    (`config-file = ?themes/glass` in ghostty/config).

    PER MODE, AND LIVE. Ghostty's documentation says changing
    `background-opacity` "requires restarting Ghostty completely"; on 1.3.1,
    macOS 26, that is not true of this include. Measured: a window running at
    0.68 went opaque the moment `background-opacity = 1.0` was written here and
    SIGUSR2 sent, with no restart. Ghostty has no `light:…,dark:…` conditional
    for opacity (only `theme` takes one -- ghostty-org/ghostty#3773 is still
    open), so per-mode glass works the way per-mode wallpaper does: write the
    one value the current appearance wants, then reload.

    Every caller must therefore write this BEFORE reload_consumers() sends the
    signal; a write after it is a value nobody has read.
    """
    opacity, blur = glass_of(setup, mode)
    (GEN_GHOSTTY_DIR / "glass").write_text(
        f"# generated by bin/theme from theme/setups/{name}.toml — do not edit\n"
        f"# the {mode} mode's glass. Rewritten on every appearance flip, and\n"
        f"# picked up live by the SIGUSR2 that follows (Ghostty 1.3.1).\n"
        f"background-opacity = {opacity}\n"
        f"background-blur = {blur}\n"
    )
    return (opacity, blur)


def write_skin(setup: dict) -> str:
    """Write theme/gen/sketchybar/skin: the name of the skin this theme wears.

    A skin is the bar's shape -- chip height, corner radius, which palette slot
    is a fill and which is text -- and it lives in sketchybar/skins/<name>.sh.
    The palette changes on every appearance flip and is applied by recolouring
    items in place; a skin cannot be, because a chip's height and radius are
    fixed when the item is created. So this is written here and the caller
    reloads the bar when it changed.

    Unknown or missing means `flat`; sketchybar/lib/skin.sh checks the name
    again before it becomes a path, because this file is generated and a theme
    naming a skin nobody wrote should leave you with a plain bar, not no bar.
    """
    skin = str(setup.get("skin", "flat"))
    (GEN_SKETCHYBAR_DIR / "skin").write_text(skin + "\n")
    return skin


def current_skin() -> str:
    try:
        return (GEN_SKETCHYBAR_DIR / "skin").read_text().strip()
    except OSError:
        return ""


def write_sketchybar_colors(name: str, setup: dict, built: dict, mode: str, path: Path) -> None:
    """Write the sketchybar colour exports for one mode, in 0xAARRGGBB form.

    Also the mode's glass -- the same opacity and blur Ghostty's window gets
    from write_glass -- so a skin can make its chips the terminal's material
    rather than an approximation of it. Opacity goes out as the alpha byte,
    the form sketchybar/lib/skin.sh's alpha() takes.
    """
    p = built["palette"]
    opacity, blur = glass_of(setup, mode)
    alpha = max(0, min(255, round(opacity * 255)))
    path.write_text(
        "\n".join(
            [
                f"# generated by bin/theme from theme/setups/{name}.toml — do not edit",
                f"export THEME_BG={_sketchybar_color(built['bg'])}",
                f"export THEME_FG={_sketchybar_color(built['fg'])}",
                f"export THEME_SURFACE={_sketchybar_color(p[0])}",
                f"export THEME_DIM={_sketchybar_color(p[8])}",
                f"export THEME_MUTED={_sketchybar_color(p[7])}",
                f"export THEME_ACCENT={_sketchybar_color(p[4])}",
                f"export THEME_GLASS_ALPHA={alpha:02x}",
                f"export THEME_GLASS_BLUR={blur}",
                "",
            ]
        )
    )


def _relink(link: Path, target: str) -> None:
    if link.is_symlink() or link.exists():
        link.unlink()
    link.symlink_to(target)


def apply_theme(name: str) -> None:
    """Generate both modes of a theme, point the current-* symlinks at it, reload."""
    setup_path = SETUPS_DIR / f"{name}.toml"
    if not setup_path.exists():
        raise SystemExit(f"theme: no such theme {name!r} (have: {', '.join(theme_names())})")
    setup = load_setup_toml(setup_path)
    GEN_GHOSTTY_DIR.mkdir(parents=True, exist_ok=True)
    GEN_SKETCHYBAR_DIR.mkdir(parents=True, exist_ok=True)
    was = current_skin()
    skin = write_skin(setup)
    for mode in ("dark", "light"):
        built = build_palette(setup, mode)
        write_ghostty_theme(name, setup, built, GEN_GHOSTTY_DIR / f"{name}-{mode}")
        write_sketchybar_colors(name, setup, built, mode, GEN_SKETCHYBAR_DIR / f"{mode}.sh")
        _relink(GEN_GHOSTTY_DIR / f"current-{mode}", f"{name}-{mode}")
        if wallpaper_choice(setup, mode) == "auto":
            render_wallpaper(built, GEN_WALLPAPER_DIR / f"{name}-{mode}.png")
    mode = macos_appearance()
    write_glass(name, setup, mode)
    print(f"theme={name}")
    set_wallpaper(name, setup, mode)
    reload_consumers(skin_changed=skin != was)


def wallpaper_choice(setup: dict, mode: str):
    """The `wallpaper` key for one mode: `[dark] wallpaper = ...` wins over the
    top-level one, so a theme can pair a photo for dark with a gradient for light."""
    return setup.get(mode, {}).get("wallpaper", setup.get("wallpaper"))


def macos_appearance() -> str:
    """'dark' or 'light', from the same switch Ghostty's theme = dark:...,light:... follows."""
    res = subprocess.run(
        ["defaults", "read", "-g", "AppleInterfaceStyle"], capture_output=True, text=True
    )
    return "dark" if res.stdout.strip() == "Dark" else "light"


def set_wallpaper(name: str, setup: dict, mode: str) -> None:
    """Point the desktop at the theme's wallpaper for `mode`. `wallpaper = "auto"`
    uses the rendered gradient; a path uses that image; no key leaves the desktop
    alone. The mode is passed in, never re-read: every consumer of one reload
    must agree on the mode, even if the appearance flips mid-run."""
    choice = wallpaper_choice(setup, mode)
    if choice is None:
        return
    if choice == "auto":
        image = GEN_WALLPAPER_DIR / f"{name}-{mode}.png"
    else:
        image = Path(os.path.expanduser(choice))
        if not image.is_absolute():
            image = REPO / "theme" / "wallpapers" / image
    if not image.exists():
        raise SystemExit(f"theme: wallpaper {image} does not exist")
    script = f'tell application "System Events" to tell every desktop to set picture to POSIX file "{image}"'
    res = subprocess.run(["osascript", "-e", script], capture_output=True, text=True)
    if res.returncode != 0:
        print(f"theme: could not set wallpaper: {res.stderr.strip()}", file=sys.stderr)


def reload_consumers(skin_changed: bool = False) -> None:
    """Reload every consumer of the palette: Ghostty, herdr, sketchybar."""
    # Ghostty reloads its config on SIGUSR2 (verified on 1.3.1). Matched on the
    # full executable path, so the helper processes are left alone.
    #
    # `-a` is load-bearing. pkill excludes itself AND all of its ancestors from
    # the match list by default, and this command is normally run from a shell
    # inside Ghostty -- so without it the one process we are trying to signal is
    # the one process that can never match, and `theme apply` silently changed
    # the files without ever reloading the terminal it was typed in.
    #
    # Argument order is load-bearing too: BSD pkill only reads the signal as the
    # FIRST argument. `pkill -a -USR2` parses as `-U SR2` -- "user SR2" -- and
    # dies with "Unknown user", which capture_output would have swallowed. Hence
    # the returncode check: rc 1 is the honest "no Ghostty running", anything
    # else is this command being wrong and must not pass silently.
    res = subprocess.run(
        ["pkill", "-USR2", "-a", "-f", "/Ghostty.app/Contents/MacOS/ghostty$"],
        check=False,
        capture_output=True,
        text=True,
    )
    if res.returncode > 1:
        print(f"theme: could not signal Ghostty: {res.stderr.strip()}", file=sys.stderr)
    if shutil.which("herdr"):
        subprocess.run(["herdr", "server", "reload-config"], check=False, capture_output=True)
    # sketchybar is recoloured in place rather than `--reload`ed: a reload
    # redraws the whole bar and kills every plugin, including the one that
    # asked for it. The appearance plugin sets exactly what the palette and the
    # mode touch, in place, and is what every flip goes through.
    #
    # A skin change is the one thing that cannot be done that way. Chip height,
    # corner radius and border width are properties of an item, set when the
    # item is created, and `--default` reaches only items added after it -- so
    # the new shape can only be had by building the bar again.
    #
    # A reload is survivable here because sketchybar/bin/supervise claims its
    # pidfile before sweeping the previous generation: the old resident
    # processes go, the new ones start, and nothing is left over. Every other
    # config that launches helpers from sketchybarrc leaks one set per reload.
    if shutil.which("sketchybar"):
        if skin_changed:
            subprocess.run(["sketchybar", "--reload"], check=False, capture_output=True)
            return
        # SENDER is inherited when this runs under the appearance plugin; the
        # plugin re-spawns `theme reload` on it, which would loop forever.
        env = {k: v for k, v in os.environ.items() if k != "SENDER"}
        env["CONFIG_DIR"] = str(SKETCHYBAR_DIR)
        for plugin in ("appearance",):
            subprocess.run([str(SKETCHYBAR_DIR / "plugins" / plugin)], env=env,
                           check=False, capture_output=True)


def reload_for_appearance() -> None:
    """Re-apply the current theme for the current macOS appearance.

    macOS posts AppleInterfaceThemeChangedNotification about twenty times per
    flip, and sketchybar runs the plugin once per post, so this is called in a
    burst. Single-flight with coalescing: the first caller does the work; the
    others leave a pending mark and exit; the worker loops while a mark exists,
    so a flip that lands mid-run is still applied, and applied once.
    """
    RELOAD_LOCK.parent.mkdir(parents=True, exist_ok=True)
    with open(RELOAD_LOCK, "w") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            RELOAD_PENDING.touch()
            return
        while True:
            RELOAD_PENDING.unlink(missing_ok=True)
            mode = macos_appearance()
            name = current_theme_name()
            if name:
                setup = load_setup_toml(SETUPS_DIR / f"{name}.toml")
                # Before reload_consumers: its SIGUSR2 is what makes the new
                # opacity land in the running window. This is the path that
                # turns an appearance flip into a change of glass.
                write_glass(name, setup, mode)
                set_wallpaper(name, setup, mode)
            reload_consumers()
            # Two reasons to go round again, and the second one is the whole
            # point. macOS posts the notification *before* the appearance flag
            # it describes is readable, so the first pass of a flip routinely
            # runs on the old mode and paints the outgoing wallpaper and glass.
            # Waiting out the burst and re-reading the flag catches that; the
            # pending mark alone does not, because every notification in the
            # burst can arrive while the flag is still stale.
            time.sleep(APPEARANCE_SETTLE)
            if not RELOAD_PENDING.exists() and macos_appearance() == mode:
                return


def print_check(name: str) -> None:
    setup = load_setup_toml(SETUPS_DIR / f"{name}.toml")
    for mode in ("dark", "light"):
        built = build_palette(setup, mode)
        floors = built["floors"]
        declared = "  ".join(f"{k} {v:g}" for k, v in sorted(floors.items()))
        opacity, blur = glass_of(setup, mode)
        print(
            f"{name} {mode}  bg {built['bg']}  slot 0 {built['palette'][0]}"
            f"  glass {opacity:g}/{blur}"
        )
        print(f"  floors: {declared}")
        print(f"  {'':<14} {'':<7}  {'on bg':>7}  {'on slot 0':>9}")
        for slot, hexval, on_bg, on_surface, note in contrast_report(built):
            print(f"  {slot:<14} {hexval}  {on_bg:5.2f}:1  {on_surface:7.2f}:1  {note}".rstrip())
        print()


HELP = """usage: theme <command>

  list              themes, with the current one marked
  current           machine-readable "theme=NAME"
  apply NAME        generate NAME, make it current, reload
  next              apply the next theme in the list (wraps)
  check [NAME]      contrast table for dark and light (default: current theme)
  reload            re-apply for the current appearance: wallpaper, Ghostty, herdr, sketchybar
"""


def main(argv: list[str]) -> int:
    cmd = argv[0] if argv else "--help"
    arg = argv[1] if len(argv) > 1 else None

    if cmd in ("-h", "--help", "help"):
        print(HELP, end="")
    elif cmd == "list":
        cur_theme = current_theme_name()
        print("themes:")
        for n in theme_names():
            print(f"  {'*' if n == cur_theme else ' '} {n}")
    elif cmd == "current":
        print(f"theme={current_theme_name() or 'none'}")
    elif cmd == "apply":
        if not arg:
            raise SystemExit("theme: apply needs a theme name")
        apply_theme(arg)
    elif cmd == "next":
        apply_theme(_next_in(theme_names(), current_theme_name()))
    elif cmd == "check":
        name = arg or current_theme_name()
        if not name:
            raise SystemExit("theme: no current theme; pass a name")
        print_check(name)
    elif cmd == "reload":
        reload_for_appearance()
    else:
        raise SystemExit(f"theme: unknown command {cmd!r}\n\n{HELP}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
